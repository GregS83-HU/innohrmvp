{
  // Used by `npm run typecheck` (and the git hooks). Same settings as
  // tsconfig.json, minus .next/types: those are generated by `next build`
  // and go stale when a page is deleted, failing the check for no real
  // reason until the next build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsc-typecheck.tsbuildinfo"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "test", ".next"]
}
