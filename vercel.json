{
  "functions": {
    "app/api/analyse-cv/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/data-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/onboarding-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "build": {
    "env": {
      "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }
}